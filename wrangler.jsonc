{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amoris-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amoris-invitations",
      // One-time setup: create the D1 database, then paste its id here.
      //   npx wrangler d1 create amoris-invitations
      // (DEPLOY.md walks through this step by step.)
      "database_id": "f510d5a3-e4b3-4b4f-9eba-5df46663a49d"
    }
  ]
}
