{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shaadi-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shaadi-invitations",
      // One-time setup: create the D1 database, then paste its id here.
      //   npx wrangler d1 create shaadi-invitations
      // (DEPLOY.md walks through this step by step.)
      "database_id": "b0648fea-79a4-49ab-b278-da34256e959c"
    }
  ]
}
